@page
@model Vectis.Web.Pages.BottleModel
@{
    ViewData["Title"] = "Preparer un biberon";
}

<section class="page-head">
    <div>
        <h1>Preparer un biberon</h1>
        <p>Choisis le lait utilise. Le biberon restera en attente jusqu'au repas.</p>
    </div>
    <a class="button" asp-page="/Feed">Donner un biberon</a>
</section>

@if (Model.Containers.Count == 0)
{
    <div class="card notice stack">
        <h2>Aucun lait disponible</h2>
        <p>Ajoute d'abord un tirage pour creer du stock utilisable.</p>
        <a class="button primary" asp-page="/Pumping">Ajouter un tirage</a>
    </div>
}
else
{
    <form method="post" class="stack">
        <div asp-validation-summary="All" class="danger"></div>

        <section class="card stack">
            <div class="card-head">
                <div>
                    <h2>Lait utilise</h2>
                    <p>La source 1 est obligatoire. La source 2 sert seulement si tu melanges deux contenants.</p>
                </div>
                <span class="pill"><span id="prepared-total">@((Model.Input.Container1Ml + Model.Input.Container2Ml).ToString())</span> ml prepares</span>
            </div>

            <div class="grid two">
                <label>Source 1
                    <select asp-for="Input.Container1Id">
                        <option value="">Choisir</option>
                        @foreach (var container in Model.Containers)
                        {
                            <option value="@container.Id">@container.Id.ToString()[..8] - @container.RemainingQuantityMl ml - @DisplayLabels.Location(container.Location) - exp @container.EstimatedExpiresAt.LocalDateTime.ToString("g")</option>
                        }
                    </select>
                </label>
                <label>Quantite source 1 (ml)
                    <input asp-for="Input.Container1Ml" type="number" min="0" data-bottle-source />
                </label>
                <label>Source 2
                    <select asp-for="Input.Container2Id">
                        <option value="">Aucune</option>
                        @foreach (var container in Model.Containers)
                        {
                            <option value="@container.Id">@container.Id.ToString()[..8] - @container.RemainingQuantityMl ml - @DisplayLabels.Location(container.Location) - exp @container.EstimatedExpiresAt.LocalDateTime.ToString("g")</option>
                        }
                    </select>
                </label>
                <label>Quantite source 2 (ml)
                    <input asp-for="Input.Container2Ml" type="number" min="0" data-bottle-source />
                </label>
            </div>
        </section>

        <section class="card stack">
            <h2>Details</h2>
            <label>Notes <textarea asp-for="Input.Notes"></textarea></label>
            <button class="primary" type="submit">Preparer le biberon</button>
        </section>
    </form>

    <script>
        (() => {
            const sources = document.querySelectorAll("[data-bottle-source]");
            const total = document.getElementById("prepared-total");

            const refresh = () => {
                const prepared = Array.from(sources).reduce((sum, input) => sum + Number(input.value || 0), 0);
                total.textContent = prepared;
            };

            sources.forEach(input => input.addEventListener("input", refresh));
            refresh();
        })();
    </script>
}
