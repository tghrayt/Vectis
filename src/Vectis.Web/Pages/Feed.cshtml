@page
@model Vectis.Web.Pages.FeedModel
@{
    ViewData["Title"] = "Donner un biberon";
}

<section class="page-head">
    <div>
        <h1>Donner un biberon</h1>
        <p>Traite les biberons prepares, note la quantite bue et garde le reste sous controle.</p>
    </div>
    <a class="button" asp-page="/Bottle"><svg class="icon"><use href="#icon-bottle" /></svg>Preparer un biberon</a>
</section>

@if (Model.BottlePrepared)
{
    <div class="card notice" style="margin-bottom:16px">
        <p>Biberon prepare. Il est maintenant disponible pour le repas.</p>
    </div>
}

@if (Model.PendingBottles.Count == 0)
{
    <div class="card notice stack">
        <h2>Aucun biberon en attente</h2>
        <p>Prepare d'abord un biberon depuis le stock.</p>
        <a class="button primary" asp-page="/Bottle"><svg class="icon"><use href="#icon-bottle" /></svg>Preparer un biberon</a>
    </div>
}
else
{
    <section class="feed-workbench">
        <aside class="feed-queue">
            <span class="eyebrow">File d'attente</span>
            @foreach (var bottle in Model.PendingOptions)
            {
                <article class="feed-queue-item @bottle.PriorityClass" data-queue-card="@bottle.Id">
                    <span class="pill @bottle.PriorityClass">@bottle.PriorityLabel</span>
                    <strong>@bottle.TotalQuantityMl ml</strong>
                    <small>@bottle.AgeLabel - @bottle.SourceCount source(s)</small>
                </article>
            }
        </aside>

        <form method="post" class="card stack feed-form">
            <div asp-validation-summary="All" class="danger"></div>
            <div class="card-head">
                <div>
                    <h2>Consommation</h2>
                    <p>Choisis un biberon, puis utilise une action rapide ou ajuste la quantite manuellement.</p>
                </div>
                <span class="pill">@Model.PendingOptions.Count en attente</span>
            </div>

            <div class="selected-feed-card" data-selected-card>
                <span class="pill @Model.SelectedBottle?.PriorityClass" data-selected-priority>@Model.SelectedBottle?.PriorityLabel</span>
                <strong data-selected-title>@Model.SelectedBottle?.TotalQuantityMl ml prepares</strong>
                <small data-selected-meta>@Model.SelectedBottle?.AgeLabel - prepare le @Model.SelectedBottle?.PreparedLabel</small>
            </div>

            <div class="quick-feed-actions feed-mode-grid">
                <button type="button" class="button" data-feed-mode="full"><svg class="icon"><use href="#icon-check" /></svg>Tout bu</button>
                <button type="button" class="button" data-feed-mode="partial"><svg class="icon"><use href="#icon-half" /></svg>Partiel</button>
                <button type="button" class="button danger-button" data-feed-mode="discard"><svg class="icon"><use href="#icon-trash" /></svg>Non consomme / jeter</button>
            </div>

            <div class="grid two">
                <label>Biberon prepare
                    <select asp-for="Input.BottleId" data-bottle-select>
                        @foreach (var bottle in Model.PendingOptions)
                        {
                            <option value="@bottle.Id"
                                    data-quantity="@bottle.TotalQuantityMl"
                                    data-priority="@bottle.PriorityLabel"
                                    data-priority-class="@bottle.PriorityClass"
                                    data-age="@bottle.AgeLabel"
                                    data-prepared="@bottle.PreparedLabel"
                                    data-sources="@bottle.SourceCount">
                                @bottle.PreparedLabel - @bottle.TotalQuantityMl ml - @bottle.SourceCount source(s)
                            </option>
                        }
                    </select>
                </label>
                <label>Quantite bue (ml)
                    <input asp-for="Input.ConsumedMl" type="number" min="0" data-consumed />
                </label>
                <label>Reaction
                    <select asp-for="Input.Reaction" asp-items="Model.ReactionOptions"></select>
                </label>
                <label>Devenir du reste
                    <input asp-for="Input.LeftoverOutcome" placeholder="jete, conserve, autre..." data-leftover />
                </label>
            </div>

            <div class="feed-result-grid">
                <div>
                    <span>Prepare</span>
                    <strong><span data-prepared-total>0</span> ml</strong>
                </div>
                <div>
                    <span>Bu</span>
                    <strong><span data-consumed-total>0</span> ml</strong>
                </div>
                <div>
                    <span>Reste</span>
                    <strong><span data-leftover-total>0</span> ml</strong>
                </div>
            </div>

            <label>Notes <textarea asp-for="Input.Notes" placeholder="Sommeil, reaction, contexte du repas..."></textarea></label>
            <button class="primary" type="submit" data-submit-label><svg class="icon"><use href="#icon-feed" /></svg><span data-submit-text>Enregistrer la consommation</span></button>
        </form>
    </section>

    <script>
        (() => {
            const select = document.querySelector("[data-bottle-select]");
            const consumed = document.querySelector("[data-consumed]");
            const leftover = document.querySelector("[data-leftover]");
            const submitText = document.querySelector("[data-submit-text]");
            const modeButtons = document.querySelectorAll("[data-feed-mode]");
            const preparedTotal = document.querySelector("[data-prepared-total]");
            const consumedTotal = document.querySelector("[data-consumed-total]");
            const leftoverTotal = document.querySelector("[data-leftover-total]");
            const selectedPriority = document.querySelector("[data-selected-priority]");
            const selectedTitle = document.querySelector("[data-selected-title]");
            const selectedMeta = document.querySelector("[data-selected-meta]");
            const queueCards = document.querySelectorAll("[data-queue-card]");

            const selectedOption = () => select.selectedOptions[0];
            const selectedQuantity = () => Number(selectedOption()?.dataset.quantity || 0);

            const refreshSelectedCard = () => {
                const option = selectedOption();
                const quantity = selectedQuantity();
                selectedPriority.textContent = option?.dataset.priority || "Pret";
                selectedPriority.className = `pill ${option?.dataset.priorityClass || "ok"}`;
                selectedTitle.textContent = `${quantity} ml prepares`;
                selectedMeta.textContent = `${option?.dataset.age || ""} - prepare le ${option?.dataset.prepared || ""}`;
                queueCards.forEach(card => card.classList.toggle("active", card.dataset.queueCard === select.value));
            };

            const refresh = () => {
                const quantity = selectedQuantity();
                consumed.max = quantity;
                if (Number(consumed.value || 0) > quantity) {
                    consumed.value = quantity;
                }

                const consumedMl = Number(consumed.value || 0);
                preparedTotal.textContent = quantity;
                consumedTotal.textContent = consumedMl;
                leftoverTotal.textContent = Math.max(0, quantity - consumedMl);
                refreshSelectedCard();
            };

            const setMode = (mode) => {
                const quantity = selectedQuantity();
                if (mode === "full") {
                    consumed.value = quantity;
                    leftover.value = "termine";
                    submitText.textContent = "Enregistrer le biberon donne";
                }

                if (mode === "partial") {
                    consumed.value = Math.max(0, Math.round(quantity / 2));
                    leftover.value = "reste jete";
                    submitText.textContent = "Enregistrer le biberon partiel";
                }

                if (mode === "discard") {
                    consumed.value = 0;
                    leftover.value = "jete";
                    submitText.textContent = "Marquer non consomme";
                }

                refresh();
            };

            select.addEventListener("change", refresh);
            consumed.addEventListener("input", refresh);
            modeButtons.forEach(button => button.addEventListener("click", () => setMode(button.dataset.feedMode)));
            refresh();
        })();
    </script>
}
