@page
@model Vectis.Web.Pages.FeedModel
@{
    ViewData["Title"] = "Donner un biberon";
}

<section class="page-head">
    <div>
        <h1>Donner un biberon</h1>
        <p>Selectionne un biberon prepare, puis note ce que bebe a bu.</p>
    </div>
    <a class="button" asp-page="/Bottle">Preparer un biberon</a>
</section>

@if (Model.BottlePrepared)
{
    <div class="card notice" style="margin-bottom:16px">
        <p>Biberon prepare. Il est maintenant disponible pour le repas.</p>
    </div>
}

@if (Model.PendingBottles.Count == 0)
{
    <div class="card notice stack">
        <h2>Aucun biberon en attente</h2>
        <p>Prepare d'abord un biberon depuis le stock.</p>
        <a class="button primary" asp-page="/Bottle">Preparer un biberon</a>
    </div>
}
else
{
    <form method="post" class="card stack">
        <div asp-validation-summary="All" class="danger"></div>
        <div class="quick-feed-actions">
            <button type="button" class="button" data-feed-mode="full">Tout bu</button>
            <button type="button" class="button" data-feed-mode="partial">Partiel</button>
            <button type="button" class="button danger-button" data-feed-mode="discard">Non consomme / jeter</button>
        </div>
        <div class="grid two">
            <label>Biberon prepare
                <select asp-for="Input.BottleId" data-bottle-select>
                    @foreach (var bottle in Model.PendingBottles)
                    {
                        <option value="@bottle.Id" data-quantity="@bottle.TotalQuantityMl">
                            @bottle.PreparedAt.LocalDateTime.ToString("g") - @bottle.TotalQuantityMl ml - @bottle.Sources.Count source(s)
                        </option>
                    }
                </select>
            </label>
            <label>Quantite bue (ml)
                <input asp-for="Input.ConsumedMl" type="number" min="0" data-consumed />
            </label>
            <label>Reaction
                <select asp-for="Input.Reaction" asp-items="Model.ReactionOptions"></select>
            </label>
            <label>Devenir du reste
                <input asp-for="Input.LeftoverOutcome" placeholder="jete, conserve, autre..." data-leftover />
            </label>
        </div>
        <label>Notes <textarea asp-for="Input.Notes"></textarea></label>
        <button class="primary" type="submit" data-submit-label>Enregistrer la consommation</button>
    </form>

    <script>
        (() => {
            const select = document.querySelector("[data-bottle-select]");
            const consumed = document.querySelector("[data-consumed]");
            const leftover = document.querySelector("[data-leftover]");
            const submit = document.querySelector("[data-submit-label]");
            const modeButtons = document.querySelectorAll("[data-feed-mode]");

            const selectedQuantity = () => {
                const option = select.selectedOptions[0];
                return Number(option?.dataset.quantity || 0);
            };

            const refresh = () => {
                const quantity = selectedQuantity();
                consumed.max = quantity;
                if (!consumed.value || Number(consumed.value) > quantity) {
                    consumed.value = quantity;
                }
            };

            const setMode = (mode) => {
                const quantity = selectedQuantity();
                if (mode === "full") {
                    consumed.value = quantity;
                    leftover.value = "termine";
                    submit.textContent = "Enregistrer le biberon donne";
                }

                if (mode === "partial") {
                    consumed.value = Math.max(0, Math.round(quantity / 2));
                    leftover.value = "reste jete";
                    submit.textContent = "Enregistrer le biberon partiel";
                }

                if (mode === "discard") {
                    consumed.value = 0;
                    leftover.value = "jete";
                    submit.textContent = "Marquer non consomme";
                }
            };

            select.addEventListener("change", refresh);
            modeButtons.forEach(button => button.addEventListener("click", () => setMode(button.dataset.feedMode)));
            refresh();
        })();
    </script>
}
