@page
@model Vectis.Web.Pages.UsersModel
@{
    ViewData["Title"] = "Utilisateurs";
}

<section class="page-head">
    <div>
        <h1>Utilisateurs</h1>
        <p>Membres et invitations de la famille.</p>
    </div>
</section>

@if (Model.IsAdmin)
{
    <form method="post" class="card stack" style="margin-bottom:16px">
        <div asp-validation-summary="ModelOnly" class="danger"></div>
        <h2>Inviter une personne</h2>
        <div class="grid two">
            <label>Email <input asp-for="Input.Email" type="email" /></label>
            <label>Role
                <select asp-for="Input.Role" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
            </label>
        </div>
        <button class="primary" type="submit">Creer l'invitation</button>
        @if (Model.CreatedInvitationLink is not null)
        {
            <p>Lien d'acceptation : <a href="@Model.CreatedInvitationLink">@Model.CreatedInvitationLink</a></p>
        }
        @if (Model.EmailStatusMessage is not null)
        {
            <p class="muted">@Model.EmailStatusMessage</p>
        }
        @if (Model.ActionStatusMessage is not null)
        {
            <p class="muted">@Model.ActionStatusMessage</p>
        }
    </form>
}
else
{
    <div class="card notice" style="margin-bottom:16px">
        <p>Tu peux consulter les membres, mais seuls les administrateurs gerent les invitations.</p>
    </div>
}

<section class="grid two">
    <div class="card">
        <h2>Membres</h2>
        <table>
            <thead><tr><th>Nom</th><th>Email</th><th>Role</th><th>Statut</th></tr></thead>
            <tbody>
            @foreach (var member in Model.Members)
            {
                <tr>
                    <td>@member.Name</td>
                    <td>@member.Email</td>
                    <td>@UsersModel.RoleLabel(member.Role)</td>
                    <td><span class="pill">@UsersModel.StatusLabel(member.Status)</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card">
        <h2>Invitations</h2>
        <table>
            <thead><tr><th>Email</th><th>Role</th><th>Statut</th><th>Date</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var invitation in Model.Invitations)
            {
                <tr>
                    <td>@invitation.Email</td>
                    <td>@UsersModel.RoleLabel(invitation.Role)</td>
                    <td><span class="pill status-@invitation.Status">@UsersModel.StatusLabel(invitation.Status)</span></td>
                    <td>@invitation.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (invitation.Status == "pending")
                        {
                            <div class="toolbar">
                                <a class="button" asp-page="/Invitation" asp-route-id="@invitation.Id">ouvrir</a>
                                @if (Model.IsAdmin)
                                {
                                    <form method="post" asp-page-handler="Resend" asp-route-invitationId="@invitation.Id">
                                        <button type="submit">Renvoyer</button>
                                    </form>
                                    <form method="post" asp-page-handler="Cancel" asp-route-invitationId="@invitation.Id">
                                        <button class="danger-button" type="submit">Annuler</button>
                                    </form>
                                }
                            </div>
                        }
                        else if (invitation.AcceptedAt is not null)
                        {
                            <span class="muted">@invitation.AcceptedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.Invitations.Count == 0)
            {
                <tr><td colspan="5" class="muted">Aucune invitation pour le moment.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
