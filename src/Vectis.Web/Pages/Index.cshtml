@page
@model IndexModel
@{
    ViewData["Title"] = "Tableau de bord";
}

<section class="page-head">
    <div>
        <h1>Tableau de bord</h1>
        <p>@Model.BabyName - supervision du stock, des biberons et de la famille.</p>
    </div>
    <div class="toolbar">
        <a class="button primary" asp-page="/Pumping">Ajouter un tirage</a>
        <a class="button" asp-page="/Bottle">Preparer un biberon</a>
    </div>
</section>

@if (Model.Summary is not null)
{
    <section class="grid stats">
        <div class="card metric"><span>Stock disponible</span><strong>@Model.Summary.TotalAvailableMl ml</strong></div>
        <div class="card metric"><span>Biberons aujourd'hui</span><strong>@Model.FeedingCountToday</strong></div>
        <div class="card metric"><span>Biberons estimes</span><strong>@Model.Summary.EstimatedBottles</strong></div>
        <div class="card metric"><span>Membres famille</span><strong>@Model.MemberCount</strong></div>
    </section>

    <section class="dashboard-band" style="margin-top:16px">
        <div class="status-panel @Model.StockHealthClass">
            <span>Etat du stock</span>
            <strong>@Model.StockHealthLabel</strong>
            <small>@Model.Summary.ExpiringSoonMl ml proche expiration</small>
        </div>
        <div class="status-panel">
            <span>Refrigerateur</span>
            <strong>@Model.Summary.RefrigeratorMl ml</strong>
            <small>stock pret a utiliser</small>
        </div>
        <div class="status-panel">
            <span>Congelateur</span>
            <strong>@Model.Summary.FreezerMl ml</strong>
            <small>reserve longue duree</small>
        </div>
        <div class="status-panel">
            <span>Invitations</span>
            <strong>@Model.PendingInvitationCount</strong>
            <small>en attente</small>
        </div>
    </section>

    <section class="grid two dashboard-grid" style="margin-top:16px">
        <div class="card stack">
            <h2>Aujourd'hui</h2>
            <div class="activity-row"><span>Tire</span><strong>@Model.Summary.PumpedTodayMl ml</strong></div>
            <div class="activity-row"><span>Bu</span><strong>@Model.Summary.ConsumedTodayMl ml</strong></div>
            <div class="activity-row"><span>Jete</span><strong>@Model.Summary.DiscardedTodayMl ml</strong></div>
            <div class="activity-row"><span>Moyenne biberon</span><strong>@Model.Summary.AverageConsumedPerBottleMl.ToString("0") ml</strong></div>
        </div>
        <div class="card stack notice">
            <h2>Prochain contenant recommande</h2>
            @if (Model.Summary.NextRecommended is null)
            {
                <p>Aucun contenant disponible.</p>
            }
            else
            {
                <p><span class="pill">@Model.Summary.NextRecommended.RemainingQuantityMl ml</span></p>
                <p>Expiration estimee : @Model.Summary.NextRecommended.EstimatedExpiresAt.LocalDateTime.ToString("g")</p>
                <p class="muted">Identifiant : @Model.Summary.NextRecommended.Id.ToString()[..8]</p>
            }
        </div>
    </section>

    <section class="grid two dashboard-grid" style="margin-top:16px">
        <div class="card">
            <h2>Biberons recents</h2>
            <div class="table-wrap">
                <table class="compact-table">
                    <thead><tr><th>Date</th><th>Prepare</th><th>Bu</th><th>Reste</th></tr></thead>
                    <tbody>
                    @foreach (var feeding in Model.RecentFeedings)
                    {
                        <tr>
                            <td>@feeding.StartedAt.LocalDateTime.ToString("g")</td>
                            <td>@feeding.PreparedQuantityMl ml</td>
                            <td>@feeding.ConsumedQuantityMl ml</td>
                            <td>@feeding.LeftoverQuantityMl ml</td>
                        </tr>
                    }
                    @if (Model.RecentFeedings.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">Aucun biberon enregistre.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <h2>Derniers tirages</h2>
            <div class="table-wrap">
                <table class="compact-table">
                    <thead><tr><th>Date</th><th>Quantite</th><th>Notes</th></tr></thead>
                    <tbody>
                    @foreach (var pumping in Model.RecentPumpingSessions)
                    {
                        <tr>
                            <td>@pumping.PumpedAt.LocalDateTime.ToString("g")</td>
                            <td>@pumping.TotalQuantityMl ml</td>
                            <td>@pumping.Notes</td>
                        </tr>
                    }
                    @if (Model.RecentPumpingSessions.Count == 0)
                    {
                        <tr><td colspan="3" class="muted">Aucun tirage enregistre.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
