@page
@model IndexModel
@{
    ViewData["Title"] = "Tableau de bord";
}

<section class="page-head">
    <div>
        <h1>Tableau de bord</h1>
        <p>@Model.BabyName - supervision du stock, des biberons et de la famille.</p>
    </div>
    <div class="toolbar">
        <a class="button primary" asp-page="/Pumping">Ajouter un tirage</a>
        <a class="button" asp-page="/Bottle">Preparer un biberon</a>
        <a class="button" asp-page="/Feed">Donner un biberon</a>
    </div>
</section>

@if (Model.Summary is not null)
{
    <section class="grid stats">
        <div class="card metric"><span>Stock disponible</span><strong>@Model.Summary.TotalAvailableMl ml</strong></div>
        <div class="card metric"><span>Biberons donnes aujourd'hui</span><strong>@Model.FeedingCountToday</strong></div>
        <div class="card metric"><span>Biberons estimes</span><strong>@Model.Summary.EstimatedBottles</strong></div>
        <div class="card metric"><span>Biberons en attente</span><strong>@Model.PendingBottleCount</strong></div>
    </section>

    <section class="card operations-card" style="margin-top:16px">
        <div class="card-head">
            <div>
                <h2>Alertes et actions</h2>
                <p>Priorites du moment pour eviter les pertes et garder le rythme des repas.</p>
            </div>
            <span class="pill">@Model.Alerts.Count alerte(s)</span>
        </div>
        @if (Model.Alerts.Count == 0)
        {
            <div class="timeline-empty">Aucune alerte active. Le stock et les biberons sont sous controle.</div>
        }
        else
        {
            <div class="alert-grid">
                @foreach (var alert in Model.Alerts)
                {
                    <article class="action-alert @alert.Severity">
                        <div>
                            <strong>@alert.Title</strong>
                            <p>@alert.Message</p>
                        </div>
                        <a class="button" href="@alert.Href">@alert.ActionLabel</a>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-band" style="margin-top:16px">
        <div class="status-panel @Model.StockHealthClass">
            <span>Etat du stock</span>
            <strong>@Model.StockHealthLabel</strong>
            <small>@Model.Summary.ExpiringSoonMl ml proche expiration</small>
        </div>
        <div class="status-panel">
            <span>Refrigerateur</span>
            <strong>@Model.Summary.RefrigeratorMl ml</strong>
            <small>stock pret a utiliser</small>
        </div>
        <div class="status-panel">
            <span>Congelateur</span>
            <strong>@Model.Summary.FreezerMl ml</strong>
            <small>reserve longue duree</small>
        </div>
        <div class="status-panel">
            <span>Famille</span>
            <strong>@Model.MemberCount</strong>
            <small>@Model.PendingInvitationCount invitation(s) en attente</small>
        </div>
    </section>

    @if (Model.PendingBottles.Count > 0)
    {
        <section class="card timeline-card" style="margin-top:16px">
            <div class="card-head">
                <div>
                    <h2>Biberons en attente</h2>
                    <p>Biberons prepares mais pas encore enregistres comme donnes.</p>
                </div>
                <a class="button" asp-page="/Feed">Tout voir</a>
            </div>
            <div class="pending-bottle-list">
                @foreach (var bottle in Model.PendingBottles.Take(3))
                {
                    <article class="pending-bottle">
                        <div>
                            <span class="muted">@bottle.PreparedAt.LocalDateTime.ToString("g")</span>
                            <strong>@bottle.TotalQuantityMl ml</strong>
                            <small>@bottle.Sources.Count source(s) - @DisplayLabels.BottleStatus(bottle.Status)</small>
                        </div>
                        <a class="button primary" asp-page="/Feed" asp-route-prepared="@bottle.Id">Donner</a>
                    </article>
                }
            </div>
        </section>
    }

    <section class="grid dashboard-main" style="margin-top:16px">
        <div class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Tendance 7 jours</h2>
                    <p>Tirages et consommations jour par jour.</p>
                </div>
                <span class="pill">@Model.MaxDailyVolumeMl ml max</span>
            </div>
            <div class="bar-chart" aria-label="Tendance 7 jours">
                @foreach (var day in Model.DailyTrend)
                {
                    <div class="bar-day">
                        <div class="bar-stack">
                            <span class="bar pumped" style="height:@Model.BarHeight(day.PumpedMl)%"></span>
                            <span class="bar consumed" style="height:@Model.BarHeight(day.ConsumedMl)%"></span>
                        </div>
                        <strong>@day.Label</strong>
                        <small>@day.Feedings bib.</small>
                    </div>
                }
            </div>
            <div class="chart-legend">
                <span><i class="legend-dot pumped"></i>Tire</span>
                <span><i class="legend-dot consumed"></i>Bu</span>
            </div>
        </div>

        <div class="card chart-card">
            <div class="card-head">
                <div>
                    <h2>Repartition stock</h2>
                    <p>Lecture rapide des volumes par zone.</p>
                </div>
            </div>
            <div class="donut-layout">
                <div class="donut" style="@Model.StockDistributionStyle">
                    <div><strong>@Model.Summary.TotalAvailableMl</strong><span>ml</span></div>
                </div>
                <div class="legend-list">
                    <div><span class="legend-swatch fridge"></span><span>Refrigerateur</span><strong>@Model.RefrigeratorPercent%</strong></div>
                    <div><span class="legend-swatch freezer"></span><span>Congelateur</span><strong>@Model.FreezerPercent%</strong></div>
                    <div><span class="legend-swatch other"></span><span>Autre</span><strong>@Model.OtherStockPercent%</strong></div>
                </div>
            </div>
        </div>
    </section>

    <section class="grid two dashboard-grid" style="margin-top:16px">
        <div class="card stack">
            <h2>Aujourd'hui</h2>
            <div class="activity-row"><span>Tire</span><strong>@Model.Summary.PumpedTodayMl ml</strong></div>
            <div class="activity-row"><span>Bu</span><strong>@Model.Summary.ConsumedTodayMl ml</strong></div>
            <div class="activity-row"><span>Jete</span><strong>@Model.Summary.DiscardedTodayMl ml</strong></div>
            <div class="activity-row"><span>Moyenne biberon</span><strong>@Model.Summary.AverageConsumedPerBottleMl.ToString("0") ml</strong></div>
        </div>
        <div class="card stack notice">
            <div class="card-head">
                <div>
                    <h2>Autonomie</h2>
                    <p>Projection basee sur les biberons estimes.</p>
                </div>
            </div>
            <div class="gauge" style="@Model.AutonomyStyle">
                <div class="gauge-ring"><strong>@Model.Summary.EstimatedBottles</strong><span>biberons</span></div>
            </div>
        </div>
    </section>

    <section class="card timeline-card" style="margin-top:16px">
        <div class="card-head">
            <div>
                <h2>Priorite operationnelle</h2>
                <p>Le contenant recommande suit la logique premier expire, premier utilise.</p>
            </div>
            <a class="button" asp-page="/Stock">Voir le stock</a>
        </div>
        @if (Model.Summary.NextRecommended is null)
        {
            <div class="timeline-empty">Aucun contenant disponible.</div>
        }
        else
        {
            <div class="priority-strip">
                <div>
                    <span class="muted">Contenant</span>
                    <strong>@Model.Summary.NextRecommended.Id.ToString()[..8]</strong>
                </div>
                <div>
                    <span class="muted">Volume</span>
                    <strong>@Model.Summary.NextRecommended.RemainingQuantityMl ml</strong>
                </div>
                <div>
                    <span class="muted">Expiration</span>
                    <strong>@Model.Summary.NextRecommended.EstimatedExpiresAt.LocalDateTime.ToString("g")</strong>
                </div>
                <div class="priority-line"><span></span></div>
            </div>
        }
    </section>

    <section class="grid two dashboard-grid" style="margin-top:16px">
        <div class="card">
            <h2>Biberons recents</h2>
            <div class="table-wrap">
                <table class="compact-table">
                    <thead><tr><th>Date</th><th>Prepare</th><th>Bu</th><th>Reste</th></tr></thead>
                    <tbody>
                    @foreach (var feeding in Model.RecentFeedings)
                    {
                        <tr>
                            <td>@feeding.StartedAt.LocalDateTime.ToString("g")</td>
                            <td>@feeding.PreparedQuantityMl ml</td>
                            <td>@feeding.ConsumedQuantityMl ml</td>
                            <td>@feeding.LeftoverQuantityMl ml</td>
                        </tr>
                    }
                    @if (Model.RecentFeedings.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">Aucun biberon enregistre.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <h2>Derniers tirages</h2>
            <div class="table-wrap">
                <table class="compact-table">
                    <thead><tr><th>Date</th><th>Quantite</th><th>Notes</th></tr></thead>
                    <tbody>
                    @foreach (var pumping in Model.RecentPumpingSessions)
                    {
                        <tr>
                            <td>@pumping.PumpedAt.LocalDateTime.ToString("g")</td>
                            <td>@pumping.TotalQuantityMl ml</td>
                            <td>@pumping.Notes</td>
                        </tr>
                    }
                    @if (Model.RecentPumpingSessions.Count == 0)
                    {
                        <tr><td colspan="3" class="muted">Aucun tirage enregistre.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
