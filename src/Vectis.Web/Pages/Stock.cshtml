@page
@model Vectis.Web.Pages.StockModel
@{
    ViewData["Title"] = "Stock";
}

<section class="page-head">
    <div>
        <h1>Stock</h1>
        <p>Priorise les contenants, surveille les expirations et prepare les biberons sans perdre le fil.</p>
    </div>
    <div class="toolbar">
        <a class="button primary" asp-page="/Pumping"><svg class="icon"><use href="#icon-plus" /></svg>Ajouter un tirage</a>
        <a class="button" asp-page="/Bottle"><svg class="icon"><use href="#icon-bottle" /></svg>Preparer</a>
    </div>
</section>

@if (Model.Summary is not null)
{
    <section class="stock-overview">
        <article class="stock-hero">
            <span class="eyebrow">Stock utilisable</span>
            <strong>@Model.Summary.TotalAvailableMl ml</strong>
            <p>@Model.Summary.EstimatedBottles biberon(s) estimes selon le volume habituel.</p>
        </article>
        <article class="stock-signal danger">
            <span>A utiliser vite</span>
            <strong>@Model.Summary.ExpiringSoonMl ml</strong>
            <small>Expiration dans les prochaines 24 h</small>
        </article>
        <article class="stock-signal">
            <span>Refrigerateur</span>
            <strong>@Model.Summary.RefrigeratorMl ml</strong>
            <small>Stock pret a utiliser</small>
        </article>
        <article class="stock-signal">
            <span>Congelateur</span>
            <strong>@Model.Summary.FreezerMl ml</strong>
            <small>Reserve longue duree</small>
        </article>
    </section>
}

<div asp-validation-summary="All" class="danger"></div>

@if (Model.ActionStatusMessage is not null)
{
    <div class="card notice" style="margin-bottom:16px">
        <p>@Model.ActionStatusMessage</p>
    </div>
}

<nav class="filter-tabs" aria-label="Filtres du stock">
    @foreach (var filter in Model.Filters)
    {
        <a class="@(Model.ActiveFilter == filter.Key ? "active" : "")" asp-page="/Stock" asp-route-filter="@filter.Key">
            <span>@filter.Label</span>
            <strong>@filter.Count</strong>
        </a>
    }
</nav>

@if (Model.Rows.Count == 0)
{
    <div class="card notice stack">
        <h2>Aucun contenant dans cette vue</h2>
        <p>Change le filtre ou ajoute un tirage pour alimenter le stock.</p>
        <a class="button primary" asp-page="/Pumping"><svg class="icon"><use href="#icon-plus" /></svg>Ajouter un tirage</a>
    </div>
}
else
{
    <section class="stock-board">
        @foreach (var row in Model.Rows)
        {
            <article class="stock-item @row.PriorityClass">
                <div class="stock-item-main">
                    <div class="stock-id">
                        <span class="pill @row.PriorityClass">@row.Priority</span>
                        <strong>@row.DisplayName</strong>
                    </div>
                    <div class="stock-volume">
                        <strong>@row.Container.RemainingQuantityMl ml</strong>
                        <span>@DisplayLabels.MilkStatus(row.Container.Status)</span>
                    </div>
                </div>

                <div class="stock-meta">
                    <div>
                        <span>Lieu</span>
                        <strong>@DisplayLabels.Location(row.Container.Location)</strong>
                    </div>
                    <div>
                        <span>Expiration</span>
                        <strong>@row.ExpirationLabel</strong>
                        <small>@row.Container.EstimatedExpiresAt.LocalDateTime.ToString("g")</small>
                    </div>
                    <div>
                        <span>Age</span>
                        <strong>@row.AgeLabel</strong>
                        <small>@row.Container.PumpedAt.LocalDateTime.ToString("g")</small>
                    </div>
                </div>

                <div class="expiry-track" aria-label="Progression vers expiration">
                    <span style="width:@row.ExpirationProgress%"></span>
                </div>

                <div class="stock-actions">
                    <a class="button primary" asp-page="/Bottle"><svg class="icon"><use href="#icon-bottle" /></svg>Preparer</a>
                    <a class="button" asp-page="/History"><svg class="icon"><use href="#icon-history" /></svg>Historique</a>
                </div>

                <details class="stock-manage">
                    <summary>Gerer ce contenant</summary>
                    <div class="stock-manage-grid">
                        <form method="post" asp-page-handler="Move" class="stock-mini-form">
                            <input type="hidden" name="Input.ContainerId" value="@row.Container.Id" />
                            <input type="hidden" name="Input.Filter" value="@Model.ActiveFilter" />
                            <label>Deplacer
                                <select name="Input.Location">
                                    @foreach (var option in Model.LocationOptions)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == row.Container.Location.ToString())">@option.Text</option>
                                    }
                                </select>
                            </label>
                            <input name="Input.Comment" placeholder="Commentaire facultatif" />
                            <button type="submit"><svg class="icon"><use href="#icon-check" /></svg>Valider</button>
                        </form>

                        <form method="post" asp-page-handler="Adjust" class="stock-mini-form">
                            <input type="hidden" name="Input.ContainerId" value="@row.Container.Id" />
                            <input type="hidden" name="Input.Filter" value="@Model.ActiveFilter" />
                            <label>Quantite restante
                                <input name="Input.RemainingQuantityMl" type="number" min="0" max="@row.Container.InitialQuantityMl" value="@row.Container.RemainingQuantityMl" />
                            </label>
                            <input name="Input.Comment" placeholder="Raison de l'ajustement" />
                            <button type="submit"><svg class="icon"><use href="#icon-check" /></svg>Ajuster</button>
                        </form>
                    </div>

                    <div class="stock-terminal-actions">
                        <form method="post" asp-page-handler="Discard">
                            <input type="hidden" name="Input.ContainerId" value="@row.Container.Id" />
                            <input type="hidden" name="Input.Filter" value="@Model.ActiveFilter" />
                            <input type="hidden" name="Input.Comment" value="Jete depuis le stock" />
                            <button class="danger-button" type="submit"><svg class="icon"><use href="#icon-trash" /></svg>Marquer jete</button>
                        </form>
                        <form method="post" asp-page-handler="Expire">
                            <input type="hidden" name="Input.ContainerId" value="@row.Container.Id" />
                            <input type="hidden" name="Input.Filter" value="@Model.ActiveFilter" />
                            <input type="hidden" name="Input.Comment" value="Marque expire depuis le stock" />
                            <button type="submit"><svg class="icon"><use href="#icon-alert" /></svg>Marquer expire</button>
                        </form>
                    </div>
                </details>
            </article>
        }
    </section>
}
