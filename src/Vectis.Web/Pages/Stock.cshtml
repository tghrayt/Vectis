@page
@model Vectis.Web.Pages.StockModel
@{
    ViewData["Title"] = "Stock";
}

<section class="page-head">
    <div>
        <h1>Stock</h1>
        <p>Contenants disponibles tries par expiration estimee.</p>
    </div>
    <a class="button primary" asp-page="/Pumping">Ajouter</a>
</section>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Quantite</th><th>Lieu</th><th>Statut</th><th>Expiration</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Containers)
            {
                <tr>
                    <td>@item.Id.ToString()[..8]</td>
                    <td><span class="pill">@item.RemainingQuantityMl ml</span></td>
                    <td>@StockModel.LocationLabel(item.Location)</td>
                    <td>@StockModel.StatusLabel(item.Status)</td>
                    <td>@item.EstimatedExpiresAt.LocalDateTime.ToString("g")</td>
                </tr>
            }
            @if (Model.Containers.Count == 0)
            {
                <tr><td colspan="5" class="muted">Aucun contenant disponible.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
