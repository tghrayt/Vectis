<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vectis</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0f766e" />
</head>
<body>
    <svg aria-hidden="true" class="icon-sprite">
        <symbol id="icon-dashboard" viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm10 7h6V4h-6v16ZM4 20h6v-3H4v3Z" /></symbol>
        <symbol id="icon-pumping" viewBox="0 0 24 24"><path d="M8 3h8v3H8V3Zm1 5h6a4 4 0 0 1 4 4v4a5 5 0 0 1-10 0V8Zm2 2v6a3 3 0 0 0 6 0v-4a2 2 0 0 0-2-2h-4Z" /></symbol>
        <symbol id="icon-stock" viewBox="0 0 24 24"><path d="M5 5h14v4H5V5Zm1 6h12v8H6v-8Zm3 2v2h6v-2H9Z" /></symbol>
        <symbol id="icon-bottle" viewBox="0 0 24 24"><path d="M9 2h6v4l-2 2v12a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2V8L9 6V2Zm2 2v3l-2 2v3h4V9l-2-2V4Z" /></symbol>
        <symbol id="icon-feed" viewBox="0 0 24 24"><path d="M7 3h10v4l-2 2v7a5 5 0 0 1-10 0V9L7 7V3Zm2 2v3l-2 2v6a3 3 0 0 0 6 0v-6l-2-2V5H9Zm8 6h2v8h-2v-8Z" /></symbol>
        <symbol id="icon-history" viewBox="0 0 24 24"><path d="M12 5a7 7 0 1 1-6.3 4H3l4-4 4 4H7.9A5 5 0 1 0 12 7V5Zm-1 4h2v4l3 2-1 1.7-4-2.4V9Z" /></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><path d="M8 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm8-1a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM2 20a6 6 0 0 1 12 0H2Zm11.5 0a6.5 6.5 0 0 0-2.2-4.8A5 5 0 0 1 22 20h-8.5Z" /></symbol>
        <symbol id="icon-settings" viewBox="0 0 24 24"><path d="M10.5 2h3l.5 2.2c.5.2.9.4 1.3.7l2.1-.8 1.5 2.6-1.7 1.4c.1.5.1 1 .1 1.5s0 1-.1 1.5l1.7 1.4-1.5 2.6-2.1-.8c-.4.3-.8.5-1.3.7l-.5 2.2h-3l-.5-2.2c-.5-.2-.9-.4-1.3-.7l-2.1.8-1.5-2.6 1.7-1.4A8 8 0 0 1 6.7 12c0-.5 0-1 .1-1.5L5.1 9.1l1.5-2.6 2.1.8c.4-.3.8-.5 1.3-.7l.5-2.2ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" /></symbol>
        <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z" /></symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M13 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2h12.2l-4.6-4.6L13 5Z" /></symbol>
        <symbol id="icon-alert" viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Zm1 14h-2v2h2v-2Zm0-7h-2v5h2v-5Z" /></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><path d="m9 16.2-3.5-3.5L4 14.2 9 19 20 8l-1.5-1.5L9 16.2Z" /></symbol>
        <symbol id="icon-half" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18V3Zm0 2v14a7 7 0 0 1 0-14Z" /></symbol>
        <symbol id="icon-trash" viewBox="0 0 24 24"><path d="M8 4h8l1 2h4v2H3V6h4l1-2Zm1 6h2v8H9v-8Zm4 0h2v8h-2v-8Zm4 0h2l-1 10H6L5 10h2l.8 8h8.4l.8-8Z" /></symbol>
        <symbol id="icon-login" viewBox="0 0 24 24"><path d="M10 17v-3H3v-4h7V7l5 5-5 5Zm3-13h7v16h-7v-2h5V6h-5V4Z" /></symbol>
    </svg>
    <header>
        <nav class="topbar">
            <a class="brand" asp-page="/Index"><span class="brand-mark">V</span>Vectis</a>
            <div class="navlinks">
                <a asp-page="/Index"><svg class="icon"><use href="#icon-dashboard" /></svg>Tableau</a>
                <a asp-page="/Pumping"><svg class="icon"><use href="#icon-pumping" /></svg>Tirage</a>
                <a asp-page="/Stock"><svg class="icon"><use href="#icon-stock" /></svg>Stock</a>
                <a asp-page="/Bottle"><svg class="icon"><use href="#icon-bottle" /></svg>Preparer</a>
                <a asp-page="/Feed"><svg class="icon"><use href="#icon-feed" /></svg>Donner</a>
                <a asp-page="/History"><svg class="icon"><use href="#icon-history" /></svg>Historique</a>
                <a asp-page="/Users"><svg class="icon"><use href="#icon-users" /></svg>Utilisateurs</a>
                <a asp-page="/Settings"><svg class="icon"><use href="#icon-settings" /></svg>Profil</a>
            </div>
            <div class="session">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Account/Logout"><button type="submit"><svg class="icon"><use href="#icon-login" /></svg>Sortir</button></form>
                }
                else
                {
                    <a asp-page="/Account/Login"><svg class="icon"><use href="#icon-login" /></svg>Connexion</a>
                }
            </div>
        </nav>
    </header>
    <div class="shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        Vectis est un outil d'organisation. Les durees de conservation sont configurables et ne remplacent pas les recommandations medicales ou sanitaires.
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
